Exponente inventario=
	1.26388009
	~	Dmnl
	~	A CALIBRAR (0 = sin efecto).
	|

Tope factor inventario=
	2.0
	~	Dmnl
	~	
	|

Disponibles ref=
	26.593125
	~	Vivienda/Hogar
	~	Vacias en venta por mil hogares en 1981.
	|

Elasticidad credito obra=
	4e-08
	~	Dmnl
	~	A CALIBRAR (0 = sin efecto).
	|

Ingreso indice=
	Ingreso indice dato*(1+Crecimiento ingreso futuro)^(MAX(0,Time-522)/12)
	~	Dmnl
	~	Renta real relativa a 1981; despues crece al ritmo de la proyeccion.
	|

Tipo capital=
	Tipo capital dato+IF THEN ELSE(Time>=Inicio politica, Politica tipos, 0)
	~	1/Year
	~	Tipo real; la politica puede sumarle puntos.
	|

Credito indice=
	Credito indice dato*IF THEN ELSE(Time>=Inicio politica, Politica credito, 1)
	~	Dmnl
	~	Credito a hogares relativo a 1981 x politica.
	|

Multiplicador inversor efectivo=
	Multiplicador inversor*IF THEN ELSE(Time>=Inicio politica, Politica inversion, 1)
	~	Dmnl
	~	m_inv x politica.
	|

Riesgo regulacion efectivo=
	Riesgo regulacion+IF THEN ELSE(Time>=Inicio politica, Politica riesgo, 0)
	~	1/Year
	~	rho_pol + politica.
	|

Politica obra efectiva=
	IF THEN ELSE(Time>=Inicio politica, Politica obra, 1)
	~	Dmnl
	~	
	|

Capacidad rehabilitacion efectiva=
	Capacidad rehabilitacion*IF THEN ELSE(Time>=Inicio politica, Politica rehabilitacion, 1)
	~	Vivienda/Month
	~	
	|

Inicio politica=
	528.0
	~	Month
	~	Mes (desde enero de 1981) en que empiezan las politicas: 528 = enero de 2025, justo despues del ultimo dato.
	|

Politica inversion=
	1.0
	~	Dmnl
	~	Multiplicador de la demanda inversora desde el inicio de la politica (1 = sin politica; 0,5 = recorte a la mitad).
	|

Politica riesgo=
	0.0
	~	1/Year
	~	Puntos de riesgo regulatorio que se suman a la rentabilidad exigida.
	|

Politica obra=
	1.0
	~	Dmnl
	~	Multiplicador de los inicios de obra (impulso de la oferta).
	|

Politica rehabilitacion=
	1.0
	~	Dmnl
	~	Multiplicador de la capacidad de rehabilitar.
	|

Politica tipos=
	0.0
	~	1/Year
	~	Puntos que se suman al tipo de interes real.
	|

Politica credito=
	1.0
	~	Dmnl
	~	Multiplicador del credito a hogares.
	|

Crecimiento ingreso futuro=
	0.01
	~	1/Year
	~	Crecimiento real anual de la renta tras 2024. SUPUESTO.
	|

Crecimiento hogares futuro=
	0.007
	~	1/Year
	~	Crecimiento anual de los hogares tras 2024 (INE: +11,1 % en 15 anos, escenario central).
	|

Tipo nominal dato=
	WITH LOOKUP(Time, ([(0,0)-(528,2)],(6,0.18146),(18,0.193752),(30,0.226825),(42,0.162188),(54,0.137552),(66,0.131198),(78,0.173854),(90,0.127021),(102,0.154833),(114,0.160999),(126,0.146042),(138,0.143458),(150,0.126454),(162,0.091875),(174,0.103333),(186,0.089792),(198,0.068542),(210,0.056458),(222,0.042083),(234,0.055625),(246,0.057292),(258,0.047083),(270,0.0375),(282,0.034),(294,0.035),(306,0.047),(318,0.055),(330,0.058),(342,0.026),(354,0.027),(366,0.037),(378,0.029),(390,0.032),(402,0.026),(414,0.023),(426,0.022),(438,0.021),(450,0.022),(462,0.019),(474,0.017),(486,0.015),(498,0.031),(510,0.04),(522,0.03)))
	~	1/Year
	~	Tipo hipotecario: oficial + 1,5 pts hasta 2003; observado en las hipotecas nuevas desde 2004 (Banco de España).
	|

Tipo nominal=
	Tipo nominal dato+IF THEN ELSE(Time>=Inicio politica, Politica tipos, 0)
	~	1/Year
	~	Tipo hipotecario nominal; la politica puede sumarle puntos.
	|

Paro dato=
	WITH LOOKUP(Time, ([(0,0)-(528,2)],(6,0.1417),(18,0.16017),(30,0.17486),(42,0.20248),(54,0.21641),(66,0.21259),(78,0.20607),(90,0.19854),(102,0.17331),(114,0.16273),(126,0.15929),(138,0.17697),(150,0.22156),(162,0.24209),(174,0.22675),(186,0.22142),(198,0.20698),(210,0.18673),(222,0.15475),(234,0.13785),(246,0.10348),(258,0.11146),(270,0.11283),(282,0.1109),(294,0.09146),(306,0.08452),(318,0.08232),(330,0.11254),(342,0.17857),(354,0.1986),(366,0.2139),(378,0.24789),(390,0.26094),(402,0.24441),(414,0.22057),(426,0.19635),(438,0.17224),(450,0.15255),(462,0.14104),(474,0.15532),(486,0.14914),(498,0.13033),(510,0.12179),(522,0.11344)))
	~	Dmnl
	~	Tasa de paro (INE/Banco Mundial).
	|

Paro ref=
	0.1417
	~	Dmnl
	~	Paro de 1981.
	|

Elasticidad empleo=
	8.67276104
	~	Dmnl
	~	A PROBAR: la demanda cae con el paro.
	|

Factor empleo=
	2.718281828^(-Elasticidad empleo*(Paro dato-Paro ref))
	~	Dmnl
	~	Efecto del paro sobre la demanda de los hogares.
	|

Elasticidad expectativa hogares=
	12.30213115
	~	Dmnl
	~	A PROBAR: los hogares compran mas si esperan que el precio suba.
	|

Factor expectativa hogares=
	2.718281828^(Elasticidad expectativa hogares*Expectativa usada)
	~	Dmnl
	~	Efecto de la expectativa sobre la demanda de los hogares.
	|

Plazo hipoteca dato=
	WITH LOOKUP(Time, ([(0,0)-(528,505)],(282,293.0),(294,309.0),(306,332.0),(318,336.0),(330,307.0),(342,296.0),(354,302.0),(366,285.0),(378,279.0),(390,267.0),(402,273.0),(414,271.0),(426,278.0),(438,282.0),(450,289.0),(462,279.0),(474,287.0),(486,294.0),(498,296.0),(510,290.0),(522,304.0)))
	~	Month
	~	Plazo medio de las hipotecas nuevas (2004-2024). Antes de 2004 se mantiene el de 2004 (supuesto).
	|

Plazo hipoteca=
	Plazo hipoteca dato+IF THEN ELSE(Time>=Inicio politica, Politica plazo, 0)
	~	Month
	~	Plazo; la politica puede alargarlo.
	|

Politica plazo=
	0.0
	~	Month
	~	Meses que se suman al plazo de las hipotecas desde el inicio de la politica.
	|

Prestamo valor dato=
	WITH LOOKUP(Time, ([(0,0)-(528,2)],(282,0.641),(294,0.642),(306,0.638),(318,0.628),(330,0.598),(342,0.563),(354,0.58),(366,0.583),(378,0.589),(390,0.574),(402,0.609),(414,0.632),(426,0.642),(438,0.656),(450,0.665),(462,0.63),(474,0.652),(486,0.654),(498,0.639),(510,0.614),(522,0.615)))
	~	Dmnl
	~	Prestamo sobre valor de las hipotecas nuevas (2004-2024). Antes se mantiene el de 2004 (supuesto).
	|

Prestamo valor=
	MIN(0.95, Prestamo valor dato+IF THEN ELSE(Time>=Inicio politica, Politica prestamo valor, 0))
	~	Dmnl
	~	Prestamo sobre valor; la politica (por ejemplo un aval publico) puede subirlo.
	|

Politica prestamo valor=
	0.0
	~	Dmnl
	~	Puntos (en tanto por uno) que se suman al prestamo/valor desde el inicio de la politica.
	|

Renta alquiler dato=
	WITH LOOKUP(Time, ([(0,0)-(528,11)],(6,3.040057),(18,2.742895),(30,2.917543),(42,2.820931),(54,2.852043),(66,3.020816),(78,3.955391),(90,4.716895),(102,5.445556),(114,5.902832),(126,6.368138),(138,5.934691),(150,5.651965),(162,5.435254),(174,5.371731),(186,5.284146),(198,5.52148),(210,5.818648),(222,6.084122),(234,5.894215),(246,5.655851),(258,5.75226),(270,5.790644),(282,5.852069),(294,5.72367),(306,5.488782),(318,5.357816),(330,5.003887),(342,5.103232),(354,5.198311),(366,4.797246),(378,4.519136),(390,4.627179),(402,5.00422),(414,5.086015),(426,5.108676),(438,5.161345),(450,5.121518),(462,5.094264),(474,5.101057),(486,5.074508),(498,4.795233),(510,4.665401),(522,4.82304)))
	~	Euro/Metro2/Month
	~	Alquiler bruto = rentabilidad por alquiler observada (Banco de España, desde 1996) x precio real. Antes de 1996, la de 1996 (supuesto).
	|

Cuota anual por euro=
	MAX(0.005, Tipo nominal)/(1-(1+MAX(0.005, Tipo nominal))^(-Plazo hipoteca/12))
	~	1/Year
	~	Cuota anual por euro prestado (intereses + amortizacion).
	|

Capacidad por pago=
	Esfuerzo maximo/(Cuota anual por euro*Prestamo valor)
	~	Year
	~	Anos de renta que un hogar puede pagar si dedica a la cuota su esfuerzo maximo.
	|

Capacidad por ahorro=
	Ahorro anios/(1-Prestamo valor)
	~	Year
	~	Anos de renta que puede pagar con su entrada (ahorro en anos de renta / parte no financiada).
	|

Capacidad hipotecaria=
	MIN(Capacidad por pago, Capacidad por ahorro)
	~	Year
	~	Anos de renta que puede pagar un hogar: manda la restriccion mas estricta.
	|

Acceso=
	Capacidad hipotecaria/Precio sobre ingreso
	~	Dmnl
	~	Capacidad de compra / precio, ambos en anos de renta. 1 = el precio justo cabe.
	|

Acceso ref=
	MIN(Esfuerzo maximo/(Cuota ref*Prestamo valor ref), Ahorro anios/(1-Prestamo valor ref))/Precio sobre ingreso ref
	~	Dmnl
	~	Acceso de 1981.
	|

Factor acceso=
	(Acceso/Acceso ref)^Elasticidad acceso
	~	Dmnl
	~	La demanda de los hogares sube o baja con el acceso, relativo a 1981.
	|

Precio fundamental=
	Capacidad hipotecaria*12*Ingreso/Superficie tipo
	~	Euro/Metro2
	~	Precio que cabe en la capacidad de compra de un hogar medio.
	|

Brecha financiera=
	Precio efectivo/(Relacion precio capacidad*Precio fundamental)-1
	~	Dmnl
	~	Precio frente a lo que financia el sistema.
	|

Esfuerzo maximo=
	0.75741847
	~	Dmnl
	~	A CALIBRAR: parte de la renta que un hogar dedica como maximo a la cuota.
	|

Ahorro anios=
	3.59331285
	~	Year
	~	A CALIBRAR: ahorro disponible para la entrada, en anos de renta.
	|

Elasticidad acceso=
	1.85273537
	~	Dmnl
	~	A CALIBRAR.
	|

Relacion precio capacidad=
	0.74697729
	~	Dmnl
	~	A CALIBRAR: a que fraccion de la capacidad tiende el precio.
	|

Velocidad financiera=
	0.0396019
	~	1/Month
	~	A CALIBRAR: rapidez con que el precio se acerca a lo que financia el sistema.
	|

Cuota ref=
	0.18460789
	~	1/Year
	~	Cuota por euro de 1981.
	|

Prestamo valor ref=
	0.641
	~	Dmnl
	~	Prestamo sobre valor de referencia (2004).
	|

Precio sobre ingreso ref=
	4.29906377
	~	Year
	~	Precio sobre renta de 1981 en el modelo.
	|

Deuda hipotecaria=
	INTEG(Nuevos prestamos-Amortizacion, 32614107854.0)
	~	Euro
	~	Deuda hipotecaria de los hogares (euros de 2010). Inicio: 30 % de la renta anual total (supuesto, solo importa la forma).
	|

Nuevos prestamos=
	Fraccion hipotecada*(Compra hogares+Compra inversora)*Precio efectivo*Superficie tipo*Prestamo valor
	~	Euro/Month
	~	Compras financiadas x precio x superficie x prestamo/valor.
	|

Fraccion hipotecada=
	0.28129641
	~	Dmnl
	~	A CALIBRAR: parte de las compras que se financian con hipoteca.
	|

Amortizacion=
	Deuda hipotecaria/(Plazo hipoteca*Fraccion vida media)
	~	Euro/Month
	~	Devolucion: el stock entre la vida media restante de los prestamos.
	|

Fraccion vida media=
	0.99998735
	~	Dmnl
	~	A CALIBRAR: vida media restante de los prestamos como fraccion del plazo.
	|

Deuda sobre renta=
	Deuda hipotecaria/(Ingreso*Hogares*12)
	~	Dmnl
	~	Deuda / renta anual total de los hogares.
	|

Deuda indice=
	Deuda sobre renta/0.3
	~	Dmnl
	~	Relativa al inicio. Se compara con el credito a hogares/PIB del BIS.
	|

Desviacion deuda=
	Deuda indice/Credito indice-1
	~	Dmnl
	~	Frente al credito a hogares sobre PIB (BIS) relativo a 1981.
	|

Ingreso indice 2024=
	1.9811985
	~	Dmnl
	~	Indice de renta de 2024.
	|

Renta alquiler efectiva=
	Renta alquiler dato*IF THEN ELSE(Time>522, Ingreso indice/Ingreso indice 2024, 1)
	~	Euro/Metro2/Month
	~	Alquiler observado hasta 2024; despues crece con la renta.
	|

