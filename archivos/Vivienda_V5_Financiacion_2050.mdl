{UTF-8}
Viviendas venta=
	INTEG(Obra a venta+Reventa propietarios+Venta inversor+Rehabilitacion+Secundarias a venta-Compra hogares-Compra inversora-Deterioro venta, 270000.0)
	~	Vivienda
	~	Vs: vacias en venta.
	|

Uso propio=
	INTEG(Compra hogares-Reventa propietarios-Deterioro uso propio, 8041176.0)
	~	Vivienda
	~	O: principales en propiedad o cedidas (73,1 % + 6,1 % del censo de 1981).
	|

Vacias inversor=
	INTEG(Compra inversora+Fin de contrato-Puesta en alquiler-Venta inversor-Deterioro vacias inversor, 2258287.5)
	~	Vivienda
	~	Vi: vacias retenidas fuera del mercado (desocupadas del censo).
	|

Alquiladas=
	INTEG(Puesta en alquiler-Fin de contrato-Deterioro alquiladas, 2111824.0)
	~	Vivienda
	~	R: principales en alquiler (20,8 % del censo de 1981).
	|

Secundarias=
	INTEG(Obra a secundarias-Secundarias a venta-Deterioro secundarias, 1898602.0)
	~	Vivienda
	~	Segundas residencias (censo 1981: 1.898.602).
	|

Deterioradas=
	INTEG(Deterioro venta+Deterioro uso propio+Deterioro vacias inversor+Deterioro alquiladas+Deterioro secundarias-Rehabilitacion-Demolicion, 280382.5)
	~	Vivienda
	~	No habitables o pendientes de recuperar.
	|

Parque retirado=
	INTEG(Demolicion, 0)
	~	Vivienda
	~	Demolidas (acumulado).
	|

En construccion=
	INTEG(Inicio obra-Obra a venta-Obra a secundarias, 474122.5)
	~	Vivienda
	~	U: en obra.
	|

Edad media=
	INTEG(Envejecimiento-Rejuvenecimiento, 360)
	~	Month
	~	Antiguedad media del parque (30 anos en 1981, supuesto).
	|

Obra terminada=
	En construccion/tau obra
	~	Vivienda/Month
	~	C: viviendas terminadas.
	|

Obra a venta=
	(1-fraccion secundaria)*Obra terminada
	~	Vivienda/Month
	~	Terminadas que salen a la venta.
	|

Obra a secundarias=
	fraccion secundaria*Obra terminada
	~	Vivienda/Month
	~	Terminadas que son segunda residencia.
	|

Reventa propietarios=
	Uso propio/tau uso propio
	~	Vivienda/Month
	~	E_h.
	|

Venta inversor=
	Vacias inversor/tau vacia inversor
	~	Vivienda/Month
	~	E_i.
	|

Puesta en alquiler=
	fraccion alquiler*Vacias inversor/tau alquilar
	~	Vivienda/Month
	~	L_i.
	|

Fin de contrato=
	Alquiladas/tau contrato
	~	Vivienda/Month
	~	F_R.
	|

Secundarias a venta=
	Secundarias/tau secundaria
	~	Vivienda/Month
	~	Segundas residencias que se ponen a la venta.
	|

Inicio obra=
	Inicio base*Politica obra efectiva*MAX(0, 1+Sensibilidad margen*Margen obra/Margen ref)*Factor inventario*Credito indice^Elasticidad credito obra
	~	Vivienda/Month
	~	I_nuevo: margen x inventario x credito x politica.
	|

Compra hogares=
	Reparto*Demanda hogares
	~	Vivienda/Month
	~	B_h.
	|

Compra inversora=
	Reparto*Demanda inversora
	~	Vivienda/Month
	~	A_i.
	|

Tasa deterioro=
	(1/tau deterioro)*(Edad media/Edad ref)^Exponente edad
	~	1/Month
	~	Deterioro por mes; crece con la edad.
	|

Deterioro venta=
	Tasa deterioro*Viviendas venta
	~	Vivienda/Month
	~	
	|

Deterioro uso propio=
	Tasa deterioro*Uso propio
	~	Vivienda/Month
	~	
	|

Deterioro vacias inversor=
	Tasa deterioro*Vacias inversor
	~	Vivienda/Month
	~	
	|

Deterioro alquiladas=
	Tasa deterioro*Alquiladas
	~	Vivienda/Month
	~	
	|

Deterioro secundarias=
	Tasa deterioro*Secundarias
	~	Vivienda/Month
	~	
	|

Rehabilitacion=
	MIN(Deterioradas/tau rehabilitacion, Capacidad rehabilitacion efectiva)
	~	Vivienda/Month
	~	H: vuelve a venta.
	|

Demolicion=
	Deterioradas/tau demolicion
	~	Vivienda/Month
	~	Da.
	|

Envejecimiento=
	1
	~	Month/Month
	~	
	|

Rejuvenecimiento=
	Edad media*Obra terminada/Parque fisico
	~	Month/Month
	~	
	|

Precio=
	INTEG(Cambio precio, Precio ref)
	~	Euro/Metro2
	~	P endogeno (euros de 2010).
	|

Expectativa ge=
	INTEG(Cambio expectativa, 0)
	~	1/Year
	~	g_e.
	|

Precio efectivo=
	IF THEN ELSE(Interruptor precio forzado=1, Precio dato, Precio)
	~	Euro/Metro2
	~	Precio usado por el resto: el dato si esta forzado.
	|

Oferta venta=
	Viviendas venta/tau venta
	~	Vivienda/Month
	~	Q_s.
	|

Reparto=
	MIN(1, Oferta venta/(Demanda hogares+Demanda inversora+Eps demanda))
	~	Dmnl
	~	lambda.
	|

Demanda hogares=
	Demanda base hogares*(Hogares/Hogares ref)^Elasticidad hogares*Factor acceso*Factor empleo*Factor expectativa hogares
	~	Vivienda/Month
	~	D_h*.
	|

Expectativa usada=
	IF THEN ELSE(Interruptor expectativa=1, Expectativa ge, Expectativa externa)
	~	1/Year
	~	
	|

Rentabilidad inversora=
	12*Renta alquiler efectiva/Precio efectivo+Expectativa usada-Tipo capital-Coste mantenimiento-Riesgo regulacion efectivo
	~	1/Year
	~	r_i.
	|

Demanda inversora=
	Multiplicador inversor efectivo*Demanda base inversora*MAX(0, 1+Sensibilidad inversora*(Rentabilidad inversora-Rentabilidad ref))
	~	Vivienda/Month
	~	D_i*.
	|

Presion=
	(Demanda hogares+Demanda inversora)/(Oferta venta+Eps oferta)
	~	Dmnl
	~	
	|

Cambio bruto precio=
	Velocidad precio*Precio*MIN(Presion-1, Techo desequilibrio)-Velocidad financiera*Precio*Brecha financiera
	~	Euro/Metro2/Month
	~	
	|

Cambio precio=
	IF THEN ELSE(Precio>Precio minimo, Cambio bruto precio, MAX(0, Cambio bruto precio))
	~	Euro/Metro2/Month
	~	
	|

Cambio precio efectivo=
	IF THEN ELSE(Interruptor precio forzado=1, Crecimiento precio dato*Precio dato/12, Cambio precio)
	~	Euro/Metro2/Month
	~	Variacion del precio usada para las expectativas.
	|

Cambio expectativa=
	(12*Cambio precio efectivo/Precio efectivo-Expectativa ge)/tau expectativa
	~	1/Year/Month
	~	
	|

Precio minimo=
	0.3*Precio ref
	~	Euro/Metro2
	~	
	|

Coste suelo=
	Fraccion suelo*Precio efectivo
	~	Euro/Metro2
	~	El suelo cuesta una fraccion del precio.
	|

Coste obra=
	Coste suelo+Coste materiales+Coste mano obra+Coste energia transporte+Coste calidad+Coste otros
	~	Euro/Metro2
	~	
	|

Margen obra=
	Precio efectivo-Coste obra-Margen minimo
	~	Euro/Metro2
	~	
	|

Hogares=
	INTEG(Formacion hogares-Disolucion hogares, 10153000.0)
	~	Hogar
	~	H.
	|

Hogares objetivo=
	Hogares dato*(1+Crecimiento hogares futuro)^(MAX(0,Time-522)/12)
	~	Hogar
	~	H* = EPA hasta 2024; despues crece al ritmo de la proyeccion.
	|

Formacion hogares=
	MAX(0, (Hogares objetivo-Hogares)/tau formacion)
	~	Hogar/Month
	~	
	|

Disolucion hogares=
	MAX(0, (Hogares-Hogares objetivo)/tau disolucion)
	~	Hogar/Month
	~	
	|

Parque habitable=
	Viviendas venta+Uso propio+Vacias inversor+Alquiladas+Secundarias
	~	Vivienda
	~	
	|

Parque fisico=
	Parque habitable+Deterioradas
	~	Vivienda
	~	N.
	|

Obras acumuladas=
	INTEG(Obra terminada, 0)
	~	Vivienda
	~	
	|

Error balance parque=
	Parque fisico-(14860272.0+Obras acumuladas-Parque retirado)
	~	Vivienda
	~	Debe valer 0.
	|

Vacancia=
	(Viviendas venta+Vacias inversor)/Parque habitable
	~	Dmnl
	~	
	|

Indice precio=
	100*Precio efectivo/Precio ref
	~	Dmnl
	~	
	|

Precio sobre ingreso=
	Precio efectivo*Superficie tipo/(12*Ingreso)
	~	Year
	~	
	|

Alquiler sobre ingreso=
	Renta alquiler efectiva*Superficie tipo/Ingreso
	~	Dmnl
	~	
	|

Disponibles por mil hogares=
	1000*Viviendas venta/Hogares
	~	Vivienda/Hogar
	~	
	|

Hogares sin alojar=
	Hogares-(Uso propio+Alquiladas)
	~	Hogar
	~	
	|

Desviacion parque=
	(Parque fisico-Parque dato)/Parque dato
	~	Dmnl
	~	Frente a la estimacion oficial.
	|

Desviacion precio=
	(Precio efectivo-Precio dato)/Precio dato
	~	Dmnl
	~	Frente al indice real del BIS anclado.
	|

