	|

INITIAL TIME  = 0
	~	Month
	~	Inicio de la simulacion.
	|

SAVEPER  =
        TIME STEP
	~	Month [0,?]
	~	Frecuencia de almacenamiento.
	|

TIME STEP  = 0.25
	~	Month [0,?]
	~	Paso de integracion.
	|

